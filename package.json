{
  "name": "blogsphere",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "node server/src/devLocal.js",
    "dev:all": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
